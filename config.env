# Shared configuration, sourced by every script (bash syntax, no spaces around "=").

# --- Upstream: Proxmox's own client repository -------------------------------
UPSTREAM_BASE="http://download.proxmox.com/debian/pbs-client"   # plain HTTP is fine: every byte is checked against the signed InRelease
UPSTREAM_SUITE="trixie"
UPSTREAM_PACKAGE="proxmox-backup-client-static"
UPSTREAM_KEYRING="keys/proxmox-archive-keyring-trixie.gpg"      # pinned, see keys/README.md
UPSTREAM_KEYRING_SHA256="136673be77aba35dcce385b28737689ad64fd785a797e57897589aed08db6e45"
UPSTREAM_SIGNER_FPR="24B30F06ECC1836A4E5EFECBA7BCD1420BFE778E"   # Proxmox Trixie Release Key
MAX_RELEASE_AGE_DAYS="${MAX_RELEASE_AGE_DAYS:-30}"               # refuse a frozen/replayed mirror

# Debian architecture ":" repository component.
# arm64 exists only in Proxmox's "test" component (official upstream static aarch64 build,
# 4.2.4-1 on 2026-09-11); published as such, labelled "test component" (decided 2026-09-11).
UPSTREAM_ARCHES="${UPSTREAM_ARCHES:-amd64:main arm64:test}"

# --- What we publish -----------------------------------------------------------
PKG_NAME="proxmox-backup-client"
PUBLIC_BASE_URL="${PUBLIC_BASE_URL:-https://nimbus.rdem-systems.com/unofficial-repository-proxmox-backup-client}"
REPO_ID="unofficial-pbs-client"
KEEP_VERSIONS="${KEEP_VERSIONS:-3}"                    # upstream versions kept per architecture (allows downgrades)
PKGREL="${PKGREL:-1}"               # our packaging revision; bump to rebuild the same upstream version
MAINTAINER="${MAINTAINER:-RDEM Systems <unofficial-pbs-client@rdem-systems.com>}"
VENDOR="RDEM Systems (unofficial repackaging, not affiliated with Proxmox Server Solutions GmbH)"
APK_KEY_NAME="unofficial-pbs-client.rsa.pub"                  # file name users drop into /etc/apk/keys
UPSTREAM_GIT="https://git.proxmox.com/?p=proxmox-backup.git"
UPSTREAM_GIT_CLONE="https://git.proxmox.com/git/proxmox-backup.git"
